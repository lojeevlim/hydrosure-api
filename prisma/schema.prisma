generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  cashier
}

enum MovementType {
  opening_balance
  receipt
  adjustment
  damage
  waste
  sale
  void_return
}

enum SaleStatus {
  completed
  voided
}

enum PaymentMethod {
  cash
  card
  ewallet
}

enum PaymentStatus {
  captured
  unverified
  voided
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String?
  googleSub    String?        @unique
  role         Role           @default(cashier)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  movements    InventoryMovement[]
  sales        Sale[]         @relation("SaleCashier")
  voidedSales  Sale[]         @relation("SaleVoidedBy")
  heldCarts    HeldCart[]
  auditLogs    AuditLog[]
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}

model Category {
  id       String     @id @default(uuid())
  name     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Unit {
  id           String    @id @default(uuid())
  name         String    @unique
  abbreviation String
  products     Product[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Supplier {
  id          String    @id @default(uuid())
  name        String    @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  products    Product[]
}

model TaxCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  /// Percent, tax-exclusive pricing (e.g. 12.00 = 12%).
  rate     Decimal   @db.Decimal(5, 2)
  products Product[]
}

model Product {
  id            String      @id @default(uuid())
  sku           String      @unique
  barcode       String?     @unique
  name          String
  description   String?
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId       String?
  brand         Brand?      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unitId        String?
  unit          Unit?       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  supplierId    String?
  supplier      Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  taxCategoryId String?
  taxCategory   TaxCategory? @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  tags          Tag[]
  cost          Decimal     @default(0) @db.Decimal(12, 2)
  price         Decimal     @db.Decimal(12, 2)
  wholesalePrice Decimal?   @db.Decimal(12, 2)
  /// Only ever changed through inventoryService.applyMovement.
  stockQty      Int         @default(0)
  reorderLevel  Int         @default(0)
  maxStock      Int?
  expirationDate DateTime?  @db.Date
  imageUrl      String?
  archivedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  variants      ProductVariant[]
  movements     InventoryMovement[]
  saleItems     SaleItem[]

  @@index([name])
  @@index([categoryId])
  @@index([archivedAt])
}

/// Schema placeholder for Phase 2 (variants are not exposed by the API yet).
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sku       String   @unique
  barcode   String?  @unique
  price     Decimal? @db.Decimal(12, 2)
}

model InventoryMovement {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  type          MovementType
  qtyChange     Int
  qtyBefore     Int
  qtyAfter      Int
  referenceType String?
  referenceId   String?
  reason        String?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

model Customer {
  id        String     @id @default(uuid())
  name      String
  phone     String?
  email     String?
  createdAt DateTime   @default(now())
  sales     Sale[]
  heldCarts HeldCart[]
}

model Sale {
  id             String        @id @default(uuid())
  /// Human-friendly receipt number source.
  number         Int           @unique @default(autoincrement())
  idempotencyKey String
  /// sha256 of the canonical checkout request; null for legacy/demo rows.
  idempotencyFingerprint String?
  status         SaleStatus    @default(completed)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  cashierId      String
  cashier        User          @relation("SaleCashier", fields: [cashierId], references: [id])
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  voidedAt       DateTime?
  voidedById     String?
  voidedBy       User?         @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidReason     String?
  items          SaleItem[]
  payments       Payment[]

  @@unique([cashierId, idempotencyKey])
  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id             String   @id @default(uuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  /// Snapshots so later catalog edits never alter history.
  sku            String
  name           String
  qty            Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  unitCost       Decimal  @db.Decimal(12, 2)
  taxRate        Decimal  @db.Decimal(5, 2)
  discountAmount Decimal  @db.Decimal(12, 2)
  /// Net of discount, before tax.
  lineSubtotal   Decimal  @db.Decimal(12, 2)
  taxAmount      Decimal  @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(uuid())
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  status      PaymentStatus
  /// Amount applied to the sale.
  amount      Decimal       @db.Decimal(12, 2)
  tendered    Decimal       @db.Decimal(12, 2)
  changeGiven Decimal       @default(0) @db.Decimal(12, 2)
  /// true only when a provider actually confirmed the funds (cash counted by cashier).
  verified    Boolean       @default(false)
  externalRef String?
  createdAt   DateTime      @default(now())

  @@index([saleId])
}

model HeldCart {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  label      String?
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  items      Json
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
