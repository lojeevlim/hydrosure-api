# Copy to .env for local development (the API reads .env in the project root).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://hydrosure:hydrosure@localhost:5432/hydrosure?schema=public
# Test database used by `npm test` (created automatically by migrate deploy)
TEST_DATABASE_URL=postgresql://hydrosure:hydrosure@localhost:5432/hydrosure_test?schema=public
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Must equal the exact origin the web app is served from (comma-separated for several).
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_MAX=10
# Google sign-in: OAuth client id (Google Cloud console). Required in production.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
STORE_NAME="Lojee Store"
CURRENCY_SYMBOL=PHP
# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@example.com
# REQUIRED, change me: 12-72 chars with lowercase, uppercase, digit and symbol; must not contain "password"
SEED_ADMIN_PASSWORD=
# Compose
POSTGRES_USER=hydrosure
POSTGRES_PASSWORD=hydrosure
POSTGRES_DB=hydrosure
